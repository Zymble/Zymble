---
/** An offer a clipper receives: a streamer paying to appear on the clipper's channel. */
import type { Offer } from '@/content/mocks';

interface Props {
  data: Offer;
  compact?: boolean;
}
const { data, compact = false } = Astro.props;
---

<div class:list={['card', compact && 'compact']} aria-hidden="true">
  <div class="top">
    <span class="av">{data.from.charAt(1).toUpperCase()}</span>
    <span class="min-w-0">
      <b>{data.from}</b>
      {data.country && <span class="country"> · {data.country}</span>}
      <span class="text">{data.text}</span>
    </span>
  </div>
  <span class="money">
    <span class="amount">{data.amount}</span>
    {data.tag && <span class="tag">{data.tag}</span>}
  </span>
  <span class="btn">{data.accept}</span>
</div>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 0.85rem;
    padding: 1.1rem;
    border: 1px solid var(--cr-rule);
    border-radius: var(--cr-radius-panel);
    background: var(--cr-surface);
  }
  .card::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: 0.45rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 0 solid var(--cr-palette-orange);
    border-width: 2.5px 0 0 2.5px;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .av {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--cr-raised);
    font-weight: 800;
  }
  .text {
    display: block;
    color: var(--cr-muted);
  }
  .country {
    color: var(--cr-muted);
    font-weight: 600;
  }
  .money {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .tag {
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    background: var(--cr-success);
    color: var(--cr-bg);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .compact .amount {
    font-size: 2rem;
  }
  .compact {
    grid-template-columns: 1fr auto;
    align-items: center;
  }
  .compact .top {
    grid-column: 1 / -1;
  }
  .amount {
    font-size: 3rem;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--cr-success);
  }
  .btn {
    justify-self: start;
    padding: 0.6rem 0.9rem;
    border-radius: var(--cr-radius-control);
    background: var(--cr-action);
    color: var(--cr-on-action);
    font-weight: 750;
  }
</style>
