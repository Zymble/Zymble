---
/**
 * /streamers/ — "control room". The streamer runs a crew of clippers:
 * a live radar of who's clipping, rewards they set, contests they run, rules on their name.
 */
import Door from '@/components/ui/Door.astro';
import FaqBlock from '@/components/ui/FaqBlock.astro';
import SignupBand from '@/components/waitlist/SignupBand.astro';
import type { Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';
import { streamerCopy } from '@/content/landings';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = streamerCopy[locale];
const who = homeCopy[locale].doors.streamer.who;
const L = c.levers;
---

<!-- Hero: headline + live radar -->
<section data-theme="dark" class="s-hero bg-cr-bg text-cr-text" aria-labelledby="s-title">
  <div class="container-cr grid items-center gap-12 py-14 md:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
    <div>
      <p class="text-cr-label text-cr-muted">{c.hero.kicker}</p>
      <h1 id="s-title" class="s-title mt-4">
        <span class="block">{c.hero.titleA}</span>
        <span class="block text-cr-selected">{c.hero.titleB}</span>
      </h1>
      <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-cr-muted">{c.hero.lead}</p>
      <Door href="#signup" who={who} action={c.hero.cta} class="mt-8 max-w-[22rem]" />
    </div>

    <figure class="radar m-0" aria-label={c.radar.title}>
      <div class="radar-bar">
        <span class="live-tag" aria-hidden="true">
          LIVE
        </span>
        <span class="tabular-nums">{c.radar.live}</span>
        <span class="ml-auto truncate text-cr-muted">{c.radar.title}</span>
      </div>
      <ul class="radar-list">
        {c.radar.rows.map((r) => (
          <li>
            <span class="avatar" aria-hidden="true">
              {r.handle.charAt(1).toUpperCase()}
            </span>
            <span class="min-w-0">
              <span class="block truncate font-semibold">{r.handle}</span>
              <span class="block truncate text-cr-caption text-cr-muted">{r.clip}</span>
            </span>
            <span class="where">{r.where}</span>
            <span class={`state ${r.state}`}>{r.status}</span>
          </li>
        ))}
      </ul>
      <div class="radar-foot">
        <div>
          <span class="block text-cr-caption text-cr-muted">{c.radar.reward[0]}</span>
          <span class="font-semibold">{c.radar.reward[1]}</span>
        </div>
        <div>
          <span class="block text-cr-caption text-cr-muted">{c.radar.contest[0]}</span>
          <span class="font-semibold">{c.radar.contest[1]}</span>
        </div>
      </div>
    </figure>
  </div>
</section>

<!-- Three levers, each with its own piece of UI -->
<section class="container-cr py-24 md:py-32" aria-labelledby="levers-title">
  <h2 id="levers-title" class="max-w-[22ch] text-title-cr [text-wrap:balance]">
    {L.title}
  </h2>

  <div class="mt-14 grid gap-20">
    <article class="lever">
      <div>
        <p class="lever-name">{L.reward.name}</p>
        <h3 class="lever-title">{L.reward.title}</h3>
        <p class="lever-body">{L.reward.body}</p>
      </div>
      <div class="mock" aria-hidden="true">
        {L.reward.rows.map(([k, v], i) => (
          <div class="mock-row">
            <span class="text-cr-muted">{k}</span>
            <span class:list={['font-semibold', i === 0 && 'mock-key']}>{v}</span>
          </div>
        ))}
      </div>
    </article>

    <article class="lever lever-flip">
      <div>
        <p class="lever-name">{L.contest.name}</p>
        <h3 class="lever-title">{L.contest.title}</h3>
        <p class="lever-body">{L.contest.body}</p>
      </div>
      <div class="mock" aria-hidden="true">
        <div class="mock-head">
          <span class="font-semibold">{L.contest.board}</span>
          <span class="text-cr-caption text-cr-muted">{L.contest.meta}</span>
        </div>
        {L.contest.rows.map(([handle, count], i) => (
          <div class="mock-row rank">
            <span class:list={['pos tabular-nums', i === 0 && 'first']}>{i + 1}</span>
            <span class="font-semibold">{handle}</span>
            <span class="ml-auto text-cr-muted tabular-nums">{count}</span>
          </div>
        ))}
      </div>
    </article>

    <article class="lever">
      <div>
        <p class="lever-name">{L.radar.name}</p>
        <h3 class="lever-title">{L.radar.title}</h3>
        <p class="lever-body">{L.radar.body}</p>
      </div>
      <div class="mock" aria-hidden="true">
        {L.radar.rows.map(([where, handle, when]) => (
          <div class="mock-row">
            <span class="where">{where}</span>
            <span class="font-semibold">{handle}</span>
            <span class="ml-auto text-cr-caption text-cr-muted">{when}</span>
          </div>
        ))}
      </div>
    </article>
  </div>
</section>

<!-- Rules on the streamer's name -->
<section class="border-t border-cr-rule bg-cr-surface py-20 md:py-28" aria-labelledby="rules-title">
  <div class="container-cr">
    <h2 id="rules-title" class="text-title-cr">
      {c.rules.title}
    </h2>
    <dl class="mt-10 grid border-t border-cr-text md:grid-cols-3">
      {c.rules.items.map(([k, v], i) => (
        <div
          class:list={[
            'py-6',
            i > 0 && 'border-t border-cr-rule md:border-t-0 md:border-l md:pl-8',
            i < 2 && 'md:pr-8',
          ]}
        >
          <dt class="text-cr-section">{k}</dt>
          <dd class="mt-2 text-cr-muted">{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<FaqBlock title={c.faq.title} items={c.faq.items} id="s-faq" />

<SignupBand locale={locale} profile="streamer" title={c.form.title} lead={c.form.lead} />

<style>
  .s-title {
    font-size: clamp(2.4rem, 5vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: var(--cr-weight-display);
    text-wrap: balance;
  }

  /* ---------- Radar ---------- */
  .radar {
    border: 1px solid var(--cr-rule);
    border-radius: var(--cr-radius-panel);
    background: var(--cr-surface);
    overflow: hidden;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.6);
  }
  .radar-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-inline: 0.85rem;
    border-bottom: 1px solid var(--cr-rule);
    font-size: var(--cr-type-label-size);
    font-weight: 600;
  }
  .live-tag {
    padding: 0.05rem 0.4rem;
    border-radius: 2px;
    background: var(--cr-palette-orange);
    color: var(--cr-palette-navy);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  .radar-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .radar-list li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    grid-template-areas: 'av main where' 'av state state';
    align-items: center;
    gap: 0.2rem 0.75rem;
    padding: 0.9rem 0.85rem;
  }
  .radar-list li + li {
    border-top: 1px solid var(--cr-rule);
  }
  @media (width >= 40rem) {
    .radar-list li {
      grid-template-columns: 2.25rem minmax(0, 1fr) 4rem 8.5rem;
      grid-template-areas: 'av main where state';
    }
  }
  .avatar {
    grid-area: av;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--cr-raised);
    font-weight: 700;
  }
  .where {
    grid-area: where;
    font-size: var(--cr-type-caption-size);
    font-weight: 700;
    color: var(--cr-muted);
  }
  .state {
    grid-area: state;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--cr-type-caption-size);
    font-weight: 600;
  }
  .state::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
  }
  .state.posted {
    color: var(--cr-info);
  }
  .state.waiting {
    color: var(--cr-selected);
  }
  .state.editing {
    color: var(--cr-success);
  }
  @media (prefers-reduced-motion: no-preference) {
    .state.editing::before {
      animation: s-pulse 1.4s var(--cr-ease-standard) infinite;
    }
  }
  @keyframes s-pulse {
    50% {
      opacity: 0.3;
    }
  }
  .radar-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--cr-rule);
    background: var(--cr-raised);
  }
  .radar-foot > div {
    padding: 0.85rem;
  }
  .radar-foot > div + div {
    border-left: 1px solid var(--cr-rule);
  }

  /* ---------- Levers ---------- */
  .lever {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (width >= 64rem) {
    .lever {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 4rem;
    }
    .lever-flip > :first-child {
      order: 2;
    }
  }
  .lever-name {
    font-size: var(--cr-type-label-size);
    font-weight: 700;
    color: var(--cr-selected);
  }
  .lever-title {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .lever-body {
    margin-top: 0.75rem;
    max-width: 44ch;
    font-size: 1.0625rem;
    color: var(--cr-muted);
  }
  .mock {
    border: 1px solid var(--cr-rule);
    border-radius: var(--cr-radius-panel);
    background: var(--cr-surface);
    overflow: hidden;
    box-shadow: 0 24px 60px -32px rgb(16 24 40 / 0.35);
  }
  .mock-head {
    display: grid;
    gap: 0.15rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--cr-rule);
  }
  .mock-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.75rem 1.1rem;
  }
  .mock-row + .mock-row {
    border-top: 1px solid var(--cr-rule);
  }
  .mock-key {
    padding: 0.2rem 0.5rem;
    border: 1px dashed var(--cr-edge);
    border-radius: var(--cr-radius-control);
  }
  .rank {
    justify-content: flex-start;
  }
  .pos {
    width: 1.5rem;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--cr-muted);
  }
  .pos.first {
    color: var(--cr-selected);
  }
  .mock .where {
    min-width: 3.5rem;
  }
</style>
