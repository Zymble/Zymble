---
/**
 * A "door": the brand CTA. Small line says who it's for, big line says what happens.
 * In/Out brackets from the symbol close in on hover, like a cut being set.
 */
interface Props {
  href: string;
  who: string;
  action: string;
  class?: string;
}
const { href, who, action, class: className } = Astro.props;
---

<a href={href} class:list={['door', className]}>
  <span class="door-who">{who}</span>
  <span class="door-action">
    {action}
    <svg
      class="door-arrow"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </span>
</a>

<style>
  .door {
    position: relative;
    display: grid;
    gap: 0.35rem;
    min-height: 5.5rem;
    padding: 1.1rem 1.35rem 1.15rem;
    border-radius: var(--cr-radius-control);
    background: var(--cr-action);
    color: var(--cr-on-action);
    text-decoration: none;
    transition: background var(--cr-duration-fast) var(--cr-ease-standard);
  }
  .door:hover {
    background: var(--cr-action-hover);
  }
  .door:active {
    background: var(--cr-action-active);
  }
  .door-who {
    font-size: var(--cr-type-label-size);
    font-weight: 600;
  }
  .door-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 1.2rem;
    font-weight: 750;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .door-arrow {
    flex: none;
    transition: transform var(--cr-duration-base) var(--cr-ease-standard);
  }
  .door:hover .door-arrow {
    transform: translateX(4px);
  }
  /* In/Out brackets that close in on hover. */
  .door::before,
  .door::after {
    content: '';
    position: absolute;
    width: 0.9rem;
    height: 0.9rem;
    border: 0 solid currentColor;
    transition: transform var(--cr-duration-base) var(--cr-ease-standard);
  }
  .door::before {
    top: 0.45rem;
    left: 0.45rem;
    border-width: 2.5px 0 0 2.5px;
  }
  .door::after {
    right: 0.45rem;
    bottom: 0.45rem;
    border-width: 0 2.5px 2.5px 0;
  }
  .door:hover::before {
    transform: translate(3px, 3px);
  }
  .door:hover::after {
    transform: translate(-3px, -3px);
  }
</style>
