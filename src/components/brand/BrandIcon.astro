---
/**
 * Interface icons. Kit icons come verbatim from brand/logo/icons (24×24, currentColor).
 * `reframe` and `chart` follow the same grid/stroke rules for the two features the kit lacks.
 */
import calendar from '../../../brand/logo/icons/calendar.svg?raw';
import captions from '../../../brand/logo/icons/captions.svg?raw';
import check from '../../../brand/logo/icons/check.svg?raw';
import playhead from '../../../brand/logo/icons/playhead.svg?raw';
import trim from '../../../brand/logo/icons/trim.svg?raw';
import upload from '../../../brand/logo/icons/upload.svg?raw';

const custom = (d: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg>`;

const icons = {
  calendar,
  captions,
  check,
  playhead,
  trim,
  upload,
  reframe: custom('M2 6h20v12H2z M9 6v12 M15 6v12'),
  chart: custom('M4 20V10 M10 20V4 M16 20v-7 M22 20H2'),
} as const;

export type BrandIconName = keyof typeof icons;

interface Props {
  name: BrandIconName;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;
const svg = icons[name].replace(
  '<svg ',
  `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `,
);
---

<span class:list={['inline-flex shrink-0', className]} set:html={svg} />
