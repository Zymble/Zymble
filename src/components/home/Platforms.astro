---
import type { Locale } from '@/config/routes';
import { site } from '@/config/site';
import { homeCopy } from '@/content/home';

interface Props {
  locale: Locale;
}
const c = homeCopy[Astro.props.locale].platforms;
const chip =
  'inline-flex min-h-9 items-center rounded-cr-circle border border-cr-rule bg-cr-surface px-3 text-cr-label text-cr-text';
---

<section class="border-y border-cr-rule bg-cr-surface/60" aria-label={`${c.from} / ${c.to}`}>
  <div class="container-cr flex flex-col gap-4 py-6 md:flex-row md:items-center md:justify-center md:gap-10">
    <div class="flex flex-wrap items-center gap-2">
      <span class="mr-1 text-cr-caption text-cr-muted">{c.from}</span>
      <ul class="flex flex-wrap gap-2">
        {site.platforms.map((p) => (
          <li class={chip}>{p}</li>
        ))}
      </ul>
      <span class="text-cr-caption text-cr-muted">{c.upload}</span>
    </div>
    <span class="hidden h-6 w-px bg-cr-rule md:block" aria-hidden="true"></span>
    <div class="flex flex-wrap items-center gap-2">
      <span class="mr-1 text-cr-caption text-cr-muted">{c.to}</span>
      <ul class="flex flex-wrap gap-2">
        {site.destinations.map((p) => (
          <li class={chip}>{p}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
