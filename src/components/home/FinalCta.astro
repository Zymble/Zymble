---
/** Closing band: the tagline as a signature, framed by the In/Out brackets, plus both doors. */
import CtaDoors from './CtaDoors.astro';
import type { Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = homeCopy[locale].final;
---

<section
  data-theme="dark"
  class="bg-cr-bg text-cr-text"
  aria-labelledby="final-title"
  id="final-cta"
>
  <div class="container-cr py-24 md:py-32">
    <div class="final-frame relative px-6 py-12 md:px-14 md:py-16">
      <h2 id="final-title" class="final-title" lang="en">
        {c.title}
      </h2>
      <p class="mt-6 max-w-[40ch] text-lg leading-relaxed text-cr-muted">{c.body}</p>
      <div class="mt-8">
        <CtaDoors locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .final-title {
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: var(--cr-weight-display);
  }
  /* In/Out brackets from the brand symbol. */
  .final-frame::before,
  .final-frame::after {
    content: '';
    position: absolute;
    width: clamp(3rem, 8vw, 6rem);
    height: clamp(2.5rem, 6vw, 4.5rem);
    border: 0 solid var(--cr-palette-orange);
  }
  .final-frame::before {
    top: 0;
    left: 0;
    border-width: 6px 0 0 6px;
  }
  .final-frame::after {
    right: 0;
    bottom: 0;
    border-width: 0 6px 6px 0;
  }
</style>
