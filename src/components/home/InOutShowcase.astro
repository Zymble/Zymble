---
import InOutTimeline from '@/components/islands/InOutTimeline.svelte';
import type { Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';

interface Props {
  locale: Locale;
}
const c = homeCopy[Astro.props.locale].inout;
---

<section class="relative py-20 md:py-28" aria-labelledby="inout-title">
  <div class="container-cr">
    <div class="max-w-3xl">
      <p class="eyebrow-cr">{c.eyebrow}</p>
      <h2 id="inout-title" class="mt-3 text-title-cr">
        {c.title}
      </h2>
      <p class="mt-4 text-lg text-cr-muted">{c.body}</p>
    </div>
    <div class="reveal mt-10">
      <InOutTimeline
        client:visible
        clips={c.clips}
        inLabel={c.inLabel}
        outLabel={c.outLabel}
        duration={c.duration}
        save={c.save}
        saved={c.saved}
        hint={c.hint}
        aiLabel={c.aiLabel}
        youLabel={c.youLabel}
      />
    </div>
    <p class="mt-4 text-cr-caption text-cr-muted">{c.disclaimer}</p>
  </div>
</section>
