---
import BrandIcon from '@/components/brand/BrandIcon.astro';
import type { Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';

interface Props {
  locale: Locale;
}
const c = homeCopy[Astro.props.locale].how;
const icons = ['upload', 'trim', 'calendar'] as const;
---

<section class="container-cr py-20 md:py-28" aria-labelledby="how-title">
  <p class="eyebrow-cr">{c.eyebrow}</p>
  <h2 id="how-title" class="mt-3 max-w-3xl text-title-cr">
    {c.title}
  </h2>

  <ol class="how-steps relative mt-12 grid gap-6 md:grid-cols-3">
    {c.steps.map((s, i) => (
      <li class="reveal cr-card relative" style={`animation-delay:${i * 80}ms`}>
        <div class="flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-cr-control bg-cr-action text-cr-on-action">
            <BrandIcon name={icons[i] ?? 'check'} />
          </span>
          <span class="text-cr-time tabular-nums text-cr-muted">0{i + 1}</span>
        </div>
        <h3 class="mt-5 text-cr-section">{s.title}</h3>
        <p class="mt-2 text-cr-muted">{s.body}</p>
      </li>
    ))}
  </ol>
</section>
