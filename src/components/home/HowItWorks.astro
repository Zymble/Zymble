---
/**
 * The problem in numbers (an illustrative example, labeled as such), then the three steps.
 * Editorial layout: big tabular numbers, hairline rules, no cards or icon tiles.
 */
import type { Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';

interface Props {
  locale: Locale;
}
const c = homeCopy[Astro.props.locale];
---

<section class="container-cr pt-24 pb-16 md:pt-32" aria-labelledby="story-title">
  <h2 id="story-title" class="max-w-[22ch] text-title-cr [text-wrap:balance]">
    {c.story.title}
  </h2>
  <p class="mt-12 text-cr-muted">{c.story.example}</p>
  <ul class="mt-4 grid border-t border-cr-text md:grid-cols-3">
    {c.story.stats.map((s, i) => (
      <li
        class:list={[
          'stat py-6 md:py-8',
          i > 0 && 'border-t border-cr-rule md:border-t-0 md:border-l md:pl-8',
          i < 2 && 'md:pr-8',
        ]}
      >
        <span class="block text-[clamp(3rem,7vw,5.5rem)] leading-none font-bold tracking-[-0.04em] tabular-nums">
          {s.value}
        </span>
        <span class="mt-3 block max-w-[24ch] text-cr-muted">{s.label}</span>
      </li>
    ))}
  </ul>
  <p class="mt-2 text-cr-caption text-cr-muted">{c.story.note}</p>
</section>

<section class="container-cr pt-8 pb-24 md:pb-32" aria-labelledby="steps-title">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <h2
      id="steps-title"
      class="text-title-cr [text-wrap:balance] lg:sticky lg:top-24 lg:self-start"
    >
      {c.steps.title}
    </h2>
    <ol class="border-t border-cr-text">
      {c.steps.items.map((s, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-x-4 border-b border-cr-rule py-8 md:grid-cols-[4.5rem_1fr]">
          <span class="text-cr-time pt-1 text-cr-muted tabular-nums">0{i + 1}</span>
          <div>
            <h3 class="text-cr-section">{s.title}</h3>
            <p class="mt-2 max-w-[46ch] text-cr-muted">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
