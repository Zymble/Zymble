---
/** Editors and agencies: who, the problem in their words, what changes. */
import type { Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = homeCopy[locale].personas;
const { href } = useTranslations(locale);
---

<section
  class="border-t border-cr-rule bg-cr-surface py-24 md:py-32"
  aria-labelledby="personas-title"
>
  <div class="container-cr">
    <h2 id="personas-title" class="max-w-[22ch] text-title-cr [text-wrap:balance]">
      {c.title}
    </h2>
    <div class="mt-12 grid border-t border-cr-text md:grid-cols-2">
      {c.items.map((p, i) => (
        <article
          class:list={[
            'flex flex-col py-8',
            i > 0 && 'border-t border-cr-rule md:border-t-0 md:border-l md:pl-8',
            i === 0 && 'md:pr-8',
          ]}
        >
          <h3 class="text-cr-label text-cr-selected">{p.who}</h3>
          <p class="mt-4 text-xl leading-snug font-semibold tracking-[-0.01em]">{p.problem}</p>
          <p class="mt-4 flex-1 text-cr-muted">{p.answer}</p>
          <a href={href(p.id)} class="mt-6 inline-flex min-h-11 items-center font-semibold">
            {p.link}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
