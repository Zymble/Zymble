---
/** ARIA tabs (WAI-APG pattern, automatic activation). Without JS every panel is shown. */
import BrandIcon from '@/components/brand/BrandIcon.astro';
import type { Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = homeCopy[locale].personas;
const { href } = useTranslations(locale);
---

<section class="bg-cr-surface py-20 md:py-28" aria-labelledby="personas-title">
  <div class="container-cr">
    <p class="eyebrow-cr">{c.eyebrow}</p>
    <h2 id="personas-title" class="mt-3 text-title-cr">
      {c.title}
    </h2>

    <div class="mt-10" data-tabs>
      <div
        role="tablist"
        aria-labelledby="personas-title"
        class="inline-flex max-w-full gap-1 overflow-x-auto rounded-cr-panel border border-cr-rule bg-cr-bg p-1"
        hidden
      >
        {c.tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${i}`}
            aria-controls={`panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="min-h-11 whitespace-nowrap rounded-cr-control border-0 bg-transparent px-4 font-semibold text-cr-muted transition-colors duration-[var(--cr-duration-fast)] aria-selected:bg-cr-action aria-selected:text-cr-on-action"
          >
            {tab.label}
          </button>
        ))}
      </div>

      {c.tabs.map((tab, i) => (
        <div
          role="tabpanel"
          id={`panel-${i}`}
          aria-labelledby={`tab-${i}`}
          tabindex="0"
          class="persona-panel mt-6 grid gap-8 rounded-cr-dialog border border-cr-rule bg-cr-bg p-6 md:grid-cols-2 md:p-10"
        >
          <div>
            <h3 class="text-cr-section md:text-[1.75rem]">{tab.title}</h3>
            <p class="mt-3 text-cr-muted">{tab.body}</p>
            <a href={href(tab.id)} class="mt-6 inline-flex min-h-11 items-center font-semibold">
              {c.link}: {tab.label} →
            </a>
          </div>
          <ul class="grid content-start gap-3">
            {tab.points.map((p) => (
              <li class="flex items-center gap-3 rounded-cr-panel border border-cr-rule bg-cr-surface p-4 font-semibold">
                <span class="grid size-8 place-items-center rounded-cr-circle bg-cr-action text-cr-on-action">
                  <BrandIcon name="check" size={18} />
                </span>
                {p}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role=tablist]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    if (!list || tabs.length === 0) return;
    list.hidden = false;

    const select = (index: number, focus = false) => {
      tabs.forEach((t, i) => {
        const on = i === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (panels[i]) panels[i].hidden = !on;
      });
      if (focus) tabs[index]?.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next =
          e.key === 'ArrowRight'
            ? i === last
              ? 0
              : i + 1
            : e.key === 'ArrowLeft'
              ? i === 0
                ? last
                : i - 1
              : e.key === 'Home'
                ? 0
                : e.key === 'End'
                  ? last
                  : null;
        if (next === null) return;
        e.preventDefault();
        select(next, true);
      });
    });
    select(0);
  });
</script>
