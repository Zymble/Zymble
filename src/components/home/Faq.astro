---
import JsonLd from '@/components/seo/JsonLd.astro';
import type { Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';

interface Props {
  locale: Locale;
}
const c = homeCopy[Astro.props.locale].faq;
---

<JsonLd
  data={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.items.map((i) => ({
      '@type': 'Question',
      name: i.q,
      acceptedAnswer: { '@type': 'Answer', text: i.a },
    })),
  }}
/>

<section class="container-cr py-20 md:py-28" aria-labelledby="faq-title">
  <div class="grid gap-8 border-t border-cr-text pt-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <h2 id="faq-title" class="text-title-cr">
      {c.title}
    </h2>
    <div class="border-t border-cr-rule lg:border-t-0">
      {c.items.map((item) => (
        <details class="faq group border-b border-cr-rule">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-semibold">
            {item.q}
            <span class="faq-sign" aria-hidden="true" />
          </summary>
          <p class="max-w-[60ch] pb-6 text-cr-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  /* Plus that turns into a minus. */
  .faq-sign {
    position: relative;
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
  }
  .faq-sign::before,
  .faq-sign::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
    transition: transform var(--cr-duration-base) var(--cr-ease-standard);
  }
  .faq-sign::after {
    transform: rotate(90deg);
  }
  .faq[open] .faq-sign::after {
    transform: rotate(0deg);
  }
  .faq summary:hover {
    color: var(--cr-selected);
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq::details-content {
      height: 0;
      overflow: clip;
      transition:
        height var(--cr-duration-enter) var(--cr-ease-standard),
        content-visibility var(--cr-duration-enter) allow-discrete;
    }
    .faq[open]::details-content {
      height: auto;
    }
  }
  :global(html) {
    interpolate-size: allow-keywords;
  }
</style>
