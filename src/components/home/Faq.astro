---
import JsonLd from '@/components/seo/JsonLd.astro';
import type { Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';

interface Props {
  locale: Locale;
}
const c = homeCopy[Astro.props.locale].faq;
---

<JsonLd
  data={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.items.map((i) => ({
      '@type': 'Question',
      name: i.q,
      acceptedAnswer: { '@type': 'Answer', text: i.a },
    })),
  }}
/>

<section class="bg-cr-surface py-20 md:py-28" aria-labelledby="faq-title">
  <div class="container-cr grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div>
      <p class="eyebrow-cr">{c.eyebrow}</p>
      <h2 id="faq-title" class="mt-3 text-title-cr">
        {c.title}
      </h2>
    </div>
    <div class="divide-y divide-cr-rule border-y border-cr-rule">
      {c.items.map((item) => (
        <details class="faq group">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-left font-semibold">
            {item.q}
            <span
              class="grid size-8 shrink-0 place-items-center rounded-cr-circle border border-cr-rule text-cr-muted transition-transform duration-[var(--cr-duration-base)] group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="pb-5 pr-12 text-cr-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq::details-content {
      transition:
        height var(--cr-duration-enter) var(--cr-ease-standard),
        content-visibility var(--cr-duration-enter) allow-discrete;
      height: 0;
      overflow: clip;
    }
    .faq[open]::details-content {
      height: auto;
    }
  }
  :global(html) {
    interpolate-size: allow-keywords;
  }
</style>
