---
/** Pricing teaser. No prices until they are decided; labeled as early access per CLAUDE.md. */
import type { Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = homeCopy[locale].pricing;
const { href } = useTranslations(locale);
---

<section class="container-cr py-20" aria-labelledby="pricing-title">
  <div class="grid gap-6 border-t border-cr-text pt-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <h2 id="pricing-title" class="text-title-cr">
      {c.title}
    </h2>
    <div>
      <p class="max-w-[46ch] text-xl leading-snug">{c.body}</p>
      <p class="mt-3 text-cr-caption text-cr-muted">{c.note}</p>
      <a href={href('pricing')} class="mt-6 inline-flex min-h-11 items-center font-semibold">
        {c.link}
      </a>
    </div>
  </div>
</section>
