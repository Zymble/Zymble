---
/**
 * Mobile-only CTA bar: appears once the hero form scrolls away, hides again
 * when the final CTA is on screen. Desktop keeps the header CTA.
 */
import type { Locale } from '@/config/routes';
import { primaryCtaHref } from '@/config/site';
import { homeCopy } from '@/content/home';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div
  class="sticky-cta fixed inset-x-0 bottom-0 z-30 border-t border-cr-rule bg-cr-bg/95 p-3 backdrop-blur md:hidden"
  data-sticky-cta
  hidden
>
  <a href={primaryCtaHref(locale)} class="cr-btn w-full">
    {homeCopy[locale].sticky}
  </a>
</div>

<style>
  .sticky-cta {
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }
  @media (prefers-reduced-motion: no-preference) {
    .sticky-cta:not([hidden]) {
      animation: cr-slide-up var(--cr-duration-enter) var(--cr-ease-standard);
    }
  }
  @keyframes cr-slide-up {
    from {
      transform: translateY(100%);
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.getElementById('hero-cta');
  const final = document.getElementById('final-cta');
  if (bar && hero) {
    const seen = new Map<Element, boolean>();
    const update = () => {
      const heroOnScreen = !!seen.get(hero) || hero.getBoundingClientRect().top > 0;
      const finalReached = !!final && final.getBoundingClientRect().top < innerHeight;
      bar.hidden = heroOnScreen || finalReached;
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => seen.set(e.target, e.isIntersecting));
      update();
    });
    io.observe(hero);
    if (final) io.observe(final);
  }
</script>
