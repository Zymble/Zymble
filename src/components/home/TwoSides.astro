---
/**
 * Both sides in one picture: the streamer puts up the prize, clippers race for it.
 * Interactive leaderboard (visitor drags the prize) + one door per side.
 */
import CtaDoors from './CtaDoors.astro';
import PrizeBoard from '@/components/islands/PrizeBoard.svelte';
import { localizedPath, type Locale } from '@/config/routes';
import { homeCopy } from '@/content/home';
import { prize } from '@/content/prize';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = homeCopy[locale].sides;
const p = prize[locale];
---

<section class="container-cr py-24 md:py-32" aria-labelledby="sides-title">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16">
    <div>
      <h2 id="sides-title" class="sides-title">
        {c.title}
      </h2>
      <CtaDoors locale={locale} class="mt-10" />
    </div>
    <PrizeBoard
      client:visible
      lang={p.lang}
      currency={p.currency}
      pool={p.pool}
      min={p.min}
      max={p.max}
      step={p.step}
      split={p.split}
      handles={p.handles}
      labels={{
        contest: p.contest,
        host: p.host,
        total: p.total,
        slider: p.slider.clipper,
        you: p.you,
        join: p.join,
        joinHref: localizedPath('clippers', locale),
        note: p.note,
      }}
    />
  </div>
</section>

<style>
  .sides-title {
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: var(--cr-weight-display);
    text-wrap: balance;
    max-width: 14ch;
  }
</style>
