---
import { localeMeta, locales, type Locale, type RouteId } from '@/config/routes';
import { site } from '@/config/site';
import { alternates } from '@/i18n/utils';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeId: RouteId;
  noindex?: boolean;
  ogImage?: string;
}
const {
  title,
  description,
  locale,
  routeId,
  noindex = false,
  ogImage = '/og/default.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const robots = noindex || !site.indexable ? 'noindex, nofollow' : 'index, follow';
const ogImageUrl = new URL(ogImage, site.url).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
{alternates(routeId, site.url).map((a) => (
  <link rel="alternate" hreflang={a.hreflang} href={a.href} />
))}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={localeMeta[locale].og} />
{locales
  .filter((l) => l !== locale)
  .map((l) => (
    <meta property="og:locale:alternate" content={localeMeta[l].og} />
  ))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
