---
import Icon from './Icon.astro';
import type { Locale } from '@/config/routes';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { t } = useTranslations(Astro.props.locale);
---

<button
  type="button"
  class="theme-toggle inline-flex size-11 items-center justify-center rounded-cr-control text-cr-text hover:bg-cr-surface-hover"
  data-label-dark={t('theme.toDark')}
  data-label-light={t('theme.toLight')}
  aria-label={t('theme.toDark')}
>
  <Icon name="moon" class="theme-icon-moon" />
  <Icon name="sun" class="theme-icon-sun" />
</button>

<style>
  :global([data-theme='dark']) .theme-toggle :global(.theme-icon-moon),
  :global(:root:not([data-theme='dark'])) .theme-toggle :global(.theme-icon-sun) {
    display: none;
  }
</style>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

  function sync() {
    const dark = root.dataset.theme === 'dark';
    buttons.forEach((b) => {
      b.setAttribute('aria-label', (dark ? b.dataset.labelLight : b.dataset.labelDark) ?? '');
    });
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('cr-theme', next);
      } catch {
        /* storage blocked: choice lasts for this page only */
      }
      sync();
    }),
  );

  // Follow the system while the visitor has not chosen explicitly.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem('cr-theme');
    } catch {
      /* ignore */
    }
    if (!stored) {
      root.dataset.theme = e.matches ? 'dark' : 'light';
      sync();
    }
  });

  sync();
</script>
