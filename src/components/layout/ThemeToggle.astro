---
/**
 * Theme control.
 * - variant "icon": one compact button with a contrast glyph (desktop header).
 * - variant "segmented": "Light | Dark" with text labels (mobile menu, footer).
 * All instances stay in sync; the choice persists in localStorage.
 */
import type { Locale } from '@/config/routes';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
  variant?: 'icon' | 'segmented';
  class?: string;
}
const { locale, variant = 'icon', class: className } = Astro.props;
const { t } = useTranslations(locale);
---

{variant === 'icon' ? (
  <button
    type="button"
    class:list={[
      'theme-icon inline-flex size-11 items-center justify-center rounded-cr-control border-0 bg-transparent text-cr-text hover:bg-cr-surface-hover',
      className,
    ]}
    data-theme-toggle
    data-label-dark={t('theme.toDark')}
    data-label-light={t('theme.toLight')}
    aria-label={t('theme.toDark')}
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.5" />
      <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor" />
    </svg>
  </button>
) : (
  <div
    class:list={['theme-seg inline-flex rounded-cr-control border border-cr-rule p-0.5', className]}
    role="group"
    aria-label={t('footer.theme')}
  >
    <button type="button" data-theme-set="light" aria-pressed="false">
      {t('theme.light')}
    </button>
    <button type="button" data-theme-set="dark" aria-pressed="false">
      {t('theme.dark')}
    </button>
  </div>
)}

<style>
  .theme-seg button {
    min-height: 2.25rem;
    min-width: 4.5rem;
    padding-inline: 0.75rem;
    border: 0;
    border-radius: calc(var(--cr-radius-control) - 2px);
    background: transparent;
    color: var(--cr-muted);
    font-size: var(--cr-type-label-size);
    font-weight: 600;
    cursor: pointer;
  }
  .theme-seg button:hover {
    color: var(--cr-text);
  }
  .theme-seg button[aria-pressed='true'] {
    background: var(--cr-raised);
    color: var(--cr-text);
  }
</style>

<script>
  const root = document.documentElement;

  function apply(theme: 'light' | 'dark', persist: boolean) {
    root.dataset.theme = theme;
    if (persist) {
      try {
        localStorage.setItem('cr-theme', theme);
      } catch {
        /* storage blocked: the choice lasts for this page only */
      }
    }
    sync();
  }

  function sync() {
    const dark = root.dataset.theme === 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-label', (dark ? b.dataset.labelLight : b.dataset.labelDark) ?? '');
    });
    document.querySelectorAll<HTMLButtonElement>('[data-theme-set]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.themeSet === (dark ? 'dark' : 'light')));
    });
  }

  document
    .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
    .forEach((b) =>
      b.addEventListener('click', () =>
        apply(root.dataset.theme === 'dark' ? 'light' : 'dark', true),
      ),
    );
  document
    .querySelectorAll<HTMLButtonElement>('[data-theme-set]')
    .forEach((b) =>
      b.addEventListener('click', () =>
        apply(b.dataset.themeSet === 'dark' ? 'dark' : 'light', true),
      ),
    );

  sync();
</script>
