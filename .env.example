# Copy to .env for local development. Never commit real values.
# Public values (PUBLIC_*) are embedded in the client bundle.

# Canonical origin of this marketing site (used for canonical URLs, sitemap, OG).
PUBLIC_SITE_URL=https://rushclippy.com
# Origin of the SaaS app (separate repo).
PUBLIC_APP_URL=https://app.rushclippy.com
# false = CTAs lead to the waitlist; true = CTAs lead to PUBLIC_APP_URL (/signup, /import?url=).
PUBLIC_APP_LIVE=false
# Plausible domain. Leave empty to disable analytics (e.g. locally).
PUBLIC_PLAUSIBLE_DOMAIN=rushclippy.com
# Cloudflare Turnstile site key (public) and secret (server only). Phase 1.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend API key and audience for the waitlist (server only). Phase 1.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Secret used to sign double opt-in links (any long random string; server only).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAITLIST_SIGNING_SECRET=
# Sender for waitlist confirmation e-mails (domain verified in Resend).
WAITLIST_FROM_EMAIL=hello@rushclippy.com
# Inbox that receives a note for each confirmed waitlist signup and /contact submissions.
CONTACT_TO_EMAIL=
# Set automatically by Vercel ("production" | "preview" | "development").
# Anything other than "production" makes the build noindex.
# VERCEL_ENV=
